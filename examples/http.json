{
  "name": "local-http-demo",
  "steps": [
    { "id": "input", "type": "text", "text": "Hello from FlowTrail" },
    {
      "id": "request",
      "type": "http",
      "url": "http://127.0.0.1:8099/echo",
      "method": "POST",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "body": "${input.output}",
      "timeoutSeconds": 5
    },
    { "id": "result", "type": "text", "text": "HTTP response: ${request.output}" }
  ]
}
